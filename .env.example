# Copy to .env.local for development. Never commit real values.
# Separate Supabase projects (and keys) per environment — dev, preview,
# production (SECURITY_STANDARDS §7.2/§9).

# Supabase project URL and publishable (anon) key. These two are the ONLY
# values allowed in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Elevated key, server environments only — never in the browser bundle, never
# committed (SECURITY_STANDARDS §11.2). It is read by exactly one module,
# src/lib/services/trusted-writer.ts, which writes activity, audit, steering
# and turn state. Those tables have no write grant for the browser-authenticated
# role, so history cannot be fabricated from a user session.
#
# Required for conversation turns: a turn records that it is running before it
# opens its stream, because steering and recovery read that record. Without
# this key a turn refuses to start rather than offering controls that cannot
# work.
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI only: superuser connection for the disposable RLS test database
# (npm run test:rls). Not used by the application.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Provider key for the live discovery engine (T9), server environments only.
# Its presence is what selects the real engine: set it and turns run against
# the model; leave it unset and turns run the deterministic scripted engine.
# There is no separate feature flag, so the two can never disagree — CI has no
# key and therefore runs the scripted engine, which is what keeps end-to-end
# and visual tests deterministic.
#
# Never expose this to the browser. It is read by the provider SDK inside
# src/lib/ai/anthropic-engine.ts, which is the only module that imports it.
ANTHROPIC_API_KEY=
